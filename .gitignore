# --- build output ---
build/
build-*/
*.velf
*.self
*.vpk
eboot.bin
param.sfo

# --- the original game, and anything extracted from it ---
# Never commit these. apk/ is the unpacked retail APK; game_out/ is the
# decompressed .s3e and data tree baked out of it. Neither is ours to
# redistribute.
apk/
game_out/

# --- derived artifacts, regenerated by scripts/ ---
# tools/ : scripts/setup.sh  (vita-parse-core)
/tools/
/ghidra/

# --- runtime debugging artifacts ---
debug.log
debug-*.log
psp2core-*.psp2dmp
dumps/*.psp2dmp
dumps/*.txt

# --- host test harness (scripts/harness.sh) ---
tests/harness/out/
tests/harness/harness

# --- local overrides ---
# Per-machine IPs etc. See scripts/env.sh.
scripts/env.local.sh

# --- editor / os ---
.vscode/
.idea/
.cache/
compile_commands.json
*.o
*.a
.DS_Store
CLAUDE.md
tests/harness/test_compress
tests/harness/test_hud
tests/harness/hud_ref/
tests/harness/*.core
